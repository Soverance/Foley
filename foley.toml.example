# Foley configuration. Copy to foley.toml (or to <data_dir>/foley.toml) and edit.
# Foley looks for its config in this order: --config, $FOLEY_CONFIG, ./foley.toml,
# <data_dir>/foley.toml.

[library]
# Root of the audio library. Every path in the catalog is stored relative to it,
# so a UNC path and a mapped drive letter for the same share both work.
root = "//nas.example.local/Assets/Audio"

# Folders directly under the root whose children are packs. For a file at
# packs/<pack>/<a>/<b>/file.wav, pack = "<pack>" and category_path = "<a>/<b>".
# Outside a pack root, pack is empty and category_path is the whole folder path.
pack_roots = ["packs"]

# Files modified more recently than this are skipped until a later run
# (they may still be copying or extracting).
settle_minutes = 10

[storage]
# Local folder for catalog.db, ledger.db and the image cache.
# Default: %LOCALAPPDATA%\Foley on Windows, ~/.local/share/foley elsewhere.
# data_dir = "C:/Users/me/AppData/Local/Foley"

[prune]
# `foley prune` removes catalog rows for files missing longer than this
# that have no ledger entries. It never touches the library.
missing_days = 30

[dedupe]
# Where `foley dedupe apply` moves duplicates. Must be on the same share as the
# library root and outside it. Unset means dedupe apply is disabled.
# quarantine_root = "//nas.example.local/Assets/Audio-Quarantine"
retention_days = 30
# When identical files live in several packs, keep the copy in the first pack
# listed here (matched as a prefix of the relative path).
keep_priority = []

[eval]
# Hand-labeled test set (kept outside the repo). See eval/testset.example.toml.
# `foley eval` scores search against it, and `foley browse` shows a Test set panel
# for marking answers while you listen (it rewrites this file, keeping its header).
# testset = "C:/Users/me/AppData/Local/Foley/testset.toml"

[search]
# Hybrid search blends keyword matching with CLAP audio-text similarity. Leave both
# unset to use what `foley eval --adopt` recorded in the catalog (the tuned values),
# else the first checkpoint in [models] clap and a blend weight of 0.5.
# clap_model = "htsat-unfused"   # a CLAP checkpoint name that has embeddings
# blend_weight = 0.5             # 0 = keyword only ... 1 = CLAP similarity only

[models]
# AudioSet tags (PANNs CNN14) and CLAP embeddings, computed by `foley index` after the
# other stages; files are searchable before they are done. Weights download on first
# use: PANNs (~330 MB) into <data_dir>/models, CLAP (0.6-0.8 GB each) into the Hugging
# Face cache (HF_HOME). With enabled = false a plain `foley index` skips them;
# `foley index --stage tags --stage embeddings` still runs them.
enabled = true
# Where inference runs: "auto" (CUDA GPU when torch sees one, else CPU), "cuda" or "cpu".
device = "auto"
# CLAP checkpoints to compute (several can coexist, so `foley eval` can compare them).
# Empty or unset = all of: "larger-general", "htsat-unfused", "htsat-fused".
# Removing one later re-runs nothing; adding one computes only that one.
# clap = ["larger-general"]

[browse]
# `foley browse` (local web UI) plays every clip matched to this integrated loudness
# when its "loudness match" toggle is on, so quiet and hot files audition at the same
# level. Playback gain only; files are never changed.
loudness_target_lufs = -20

# Where `foley browse` listens (--host/--port override these). The default keeps it on
# this machine. To serve it to the studio network, bind every interface and list the
# host names other machines will use (e.g. an internal DNS record pointing here).
# Requests are answered only when their Host header is localhost, a loopback IP, one of
# allowed_hosts (case-insensitive, port ignored) or, for a non-loopback bind, this
# machine's own name or IP: other names get 403, which blocks DNS rebinding. Mind your
# sample licences before serving the library beyond the people licensed to use it.
host = "127.0.0.1"
port = 8765
allowed_hosts = []
# host = "0.0.0.0"
# port = 80
# allowed_hosts = ["foley.example.lan"]

# Optional branding for the browser's top bar, kept outside the repo: a folder that may
# hold `logo.png` (the round mark next to the product name, shown 30 px wide, so about
# 128 px square is plenty) and `wordmark.png` (a light-on-dark line under the name, shown
# 7 px tall). Either may be missing. Without brand_dir the UI shows a neutral mark.
# brand_dir = "C:/Users/you/AppData/Local/Foley/brand"

[schedule]
# Daily library scan run by `foley browse` while it is running (an incremental
# `foley index`; read-only on the library). These are defaults: once someone saves the
# schedule in the browser's Scans dialog, enabled/time/catch_up live in
# <data_dir>/schedule.json and override this table (delete that file to fall back).
enabled = false
# Local wall-clock time on the machine running `foley browse`, 24-hour "HH:MM".
time = "03:00"
# If the server was not running at the scheduled time, scan after it starts when the
# last completed scan is older than the most recent scheduled time...
catch_up = true
# ...this many minutes after start, so the network and the NAS are up after logon.
startup_delay_minutes = 5
